


import numpy as np
# --- 1D Numpy Arrays ---
list = [20, 27, 9, 12, 31, 17, 4, 50, 39, 35]
arr = np.array(list)
print(arr*4)
print(np.mean(arr))
print(np.median(arr))
print(np.std(arr))
print(np.argmin(arr))
print(np.argmax(arr))
print(arr[6])
print(arr[7])
print(np.min(arr))
print(np.max(arr))
# the last two steps match up!



